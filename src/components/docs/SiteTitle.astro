---
// The landing page's wordmark, so the docs read as the same site, plus a link to the docs home.
---

<div class="site-title" translate="no">
  <a class="wordmark" href="/">
    <img src="/brand/mora-logo.svg" alt="" width="44" height="18" />
    <span>MORA</span>
  </a>
  <a class="section" href="/docs/">Docs</a>
</div>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    white-space: nowrap;
  }
  .site-title a {
    text-decoration: none;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 600 17px/1 var(--mora-font-display);
    letter-spacing: 0.28em;
    color: var(--sl-color-white);
  }
  .wordmark img {
    width: 44px;
    height: 18px;
    object-fit: contain;
  }
  .section {
    padding-left: 16px;
    border-left: 1px solid var(--sl-color-hairline);
    font: 500 15px/22px var(--sl-font);
    color: var(--sl-color-gray-2);
  }
  .section:hover,
  .wordmark:hover {
    color: var(--sl-color-white);
  }
</style>
