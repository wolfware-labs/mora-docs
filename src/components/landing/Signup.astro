---
import Newsletter from './Newsletter';
import { newsletterAction } from '../../lib/newsletter';

// The form only renders when the build has a MailerLite endpoint.
const action = newsletterAction(import.meta.env);
---

<div style="flex: 1 1 420px; min-width: 0; padding: 28px; border-radius: 16px; border: 1px solid #33232D; background: #180E13">
  {action && <Newsletter client:load action={action} />}
  <a
    href="https://github.com/wolfware-labs/mora-lang"
    style={`${action ? 'margin-top: 20px; ' : ''}display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 600; text-decoration: none`}
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"></path></svg>Star wolfware-labs/mora-lang</a
  >
</div>
