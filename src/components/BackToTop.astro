---
// A button that appears once the page has scrolled past the first screen and takes the reader
// back to the top. Used by the landing page, the roadmap and every docs page.
---

<button class="to-top" type="button" data-shown="false" inert aria-label="Back to top">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M6 14.5 12 8.5l6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.to-top');
  if (button) {
    // Starlight renders this inside its footer, whose stacking context sits under the
    // table of contents; as a child of <body> the button stays on top everywhere.
    if (button.parentElement !== document.body) document.body.append(button);
    let shown = false;
    const update = () => {
      const on = window.scrollY > window.innerHeight * 0.6;
      if (on === shown) return;
      shown = on;
      button.dataset.shown = String(on);
      button.inert = !on;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    button.addEventListener('click', () => {
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
      // Keyboard users land at the start of the page, not on a button that is about to hide.
      document.querySelector<HTMLElement>('a[href], button')?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .to-top {
    --to-top-bg: #1c1218;
    --to-top-border: #4a3340;
    --to-top-fg: #ffd27a;
    position: fixed;
    right: max(24px, env(safe-area-inset-right));
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 50;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--to-top-border);
    border-radius: 12px;
    background: var(--to-top-bg);
    color: var(--to-top-fg);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }
  :global(:root[data-theme='light']) .to-top {
    --to-top-bg: #fbf6f0;
    --to-top-border: #e2d3c7;
    --to-top-fg: #a8311f;
    box-shadow: 0 10px 30px rgb(74 14 59 / 0.15);
  }
  .to-top[data-shown='true'] {
    opacity: 1;
    transform: none;
  }
  .to-top:hover {
    background: #f39c3d;
    border-color: #f39c3d;
    color: #1a0e12;
  }
  .to-top:hover svg {
    transform: translateY(-2px);
  }
  .to-top svg {
    transition: transform 0.25s ease;
  }
  .to-top:focus-visible {
    outline: 2px solid #ffd27a;
    outline-offset: 3px;
  }
  @media (max-width: 600px) {
    .to-top {
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top,
    .to-top svg {
      transition: none;
    }
  }
</style>
