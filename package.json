{
  "name": "mora-site",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-spec.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-spec.mjs",
    "build": "astro build && node scripts/precompress.mjs \"${MORA_OUT_DIR:-dist}/client\"",
    "preview": "astro preview",
    "release": "semantic-release",
    "test": "vitest run --passWithNoTests",
    "typecheck": "node scripts/sync-spec.mjs && astro sync && tsc --noEmit",
    "test:e2e": "playwright test",
    "snapshot": "node scripts/snapshot-roadmap.ts",
    "start": "node server/main.mjs"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.12",
    "@astrojs/react": "^7.1.0",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "semantic-release": "25.0.9",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "sirv": "^3.0.2"
  }
}
